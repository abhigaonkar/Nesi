<%@ Master Language="C#" AutoEventWireup="true" Inherits="MobileMaster" EnableTheming="false"  Codebehind="mobile.master.cs" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
	<meta content="True" name="HandheldFriendly" />
	<meta content="width=device-width, initial-scale=1, maximum-scale=10, minimum-scale=1 user-scalable=1" name="viewport" />
	<meta name="viewport" content="width=device-width" />
	<meta name="theme-color" content="#4682B4">
	<title></title>
	<link type="text/css" media="all" rel="Stylesheet" href="/mobile/css/base.css" />
	<link href="css/base/ui.all.css" rel="stylesheet" type="text/css" /> 
	<link rel="shortcut icon" runat="server" id="ico" type="image/x-icon" />
    <meta name="mobile-web-app-capable" content="yes"/>
	<meta http-equiv="Pragma" content="no-cache" />
	<meta http-equiv="Expires" content="-1" />
	<meta http-equiv="CACHE-CONTROL" content="NO-CACHE" />
</head>
<body>
	<script type="text/javascript" src="/js/jquery-1.3.2.min.js"></script>
	<script type="text/javascript" src="/js/functions.js"></script>
	<script type="text/javascript" src="/mobile/js/base.js"></script>
	<script type="text/javascript">
	$(document).ready(function()
		{
		page_obj.update_panel_progress.bind();
		});
	</script>
	<asp:ContentPlaceHolder ID="CPH_head" runat="server">
		
	</asp:ContentPlaceHolder>
	<form id="form_main" method="post" runat="server">
<asp:ScriptManager ID="sm" runat="server">
</asp:ScriptManager>
			<div>
				<asp:ContentPlaceHolder ID="CPH_body" runat="server">
				</asp:ContentPlaceHolder>
			</div>
	</form>
</body>
</html>
