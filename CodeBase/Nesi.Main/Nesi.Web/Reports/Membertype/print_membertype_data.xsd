                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT DISTINCT 
                         CONCAT(cr_group.name, ' - ', core_responsibilities.core_responsibility) AS core_responsibility, core_responsibilities.status, core_responsibilities.daily AS daily, core_responsibilities.description AS description, 
                         core_responsibilities.weekly AS weekly, core_responsibilities.monthly AS monthly, core_responsibilities.quarterly AS quarterly, core_responsibilities.annually AS annually, 
                         core_responsibilities.as_required AS as_required, cr_group.name
FROM            membertype_responsibilities INNER JOIN
                         core_responsibilities ON membertype_responsibilities.core_responsibility_id = core_responsibilities.id INNER JOIN
                         cr_group ON core_responsibilities.cr_group_id = cr_group.id
WHERE        (membertype_responsibilities.membertype_id = ?mtid) AND status = 'Active'
ORDER BY membertype_responsibilities.mt_cr_priority</CommandText>
