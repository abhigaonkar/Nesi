                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT DISTINCT certificates.id, certificates.certificate_name AS certificates, certificates_credential_link.credential
FROM            certificates INNER JOIN
                         certificates_credential_link ON certificates.id = certificates_credential_link.certificate_id AND certificates_credential_link.state_province = ?prov INNER JOIN
                         cr_certificates ON certificates.id = cr_certificates.certificates_id INNER JOIN
                         core_responsibilities ON cr_certificates.cr_id = core_responsibilities.id INNER JOIN
                         membertype_responsibilities ON membertype_responsibilities.core_responsibility_id = core_responsibilities.id
WHERE        membertype_responsibilities.membertype_id = ?mtid AND core_responsibilities.status = 'Active'
ORDER BY membertype_responsibilities.mt_cr_priority</CommandText>
