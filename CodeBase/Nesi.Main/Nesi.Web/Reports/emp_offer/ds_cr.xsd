                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT DISTINCT
	if (
		memberoffer_cr.cr_wording IS NULL,
		core_responsibilities.core_responsibility,
		memberoffer_cr.cr_wording
	) AS core_responsibility,
	core_responsibilities.`status`,
	if (
		memberoffer_cr.daily IS NULL,
		core_responsibilities.daily,
		memberoffer_cr.daily
	) AS daily,
	core_responsibilities.description AS description,
	if (
		memberoffer_cr.weekly IS NULL,
		core_responsibilities.weekly,
		memberoffer_cr.weekly
	) AS weekly,
	if (
		memberoffer_cr.monthly IS NULL,
		core_responsibilities.monthly,
		memberoffer_cr.monthly
	) AS monthly,
	if (
		memberoffer_cr.quarterly IS NULL,
		core_responsibilities.quarterly,
		memberoffer_cr.quarterly
	) AS quarterly,
	if (
		memberoffer_cr.annually IS NULL,
		core_responsibilities.annually,
		memberoffer_cr.annually
	) AS annually,
	if (
		memberoffer_cr.as_required IS NULL,
		core_responsibilities.as_required,
		memberoffer_cr.as_required
	) AS as_required,
	cr_group.`name`,
	cr_group.`name` AS Expr1,
	membertype_responsibilities.mt_cr_priority,
	core_responsibilities.id AS crid
FROM
	memberoffer_cr
INNER JOIN core_responsibilities ON memberoffer_cr.memberoffer_crid = core_responsibilities.id
INNER JOIN cr_group ON core_responsibilities.cr_group_id = cr_group.id
INNER JOIN member_offers ON memberoffer_cr.memberoffer_moid = member_offers.id
INNER JOIN membertype_responsibilities ON member_offers.membertypeid = membertype_responsibilities.membertype_id
AND core_responsibilities.id = membertype_responsibilities.core_responsibility_id
AND core_responsibilities.`status` = 'Active'
WHERE
	(
		memberoffer_cr.memberoffer_moid = ?moid
	)
ORDER BY
	membertype_responsibilities.mt_cr_priority ASC,
	CONCAT(
		cr_group. NAME,
		' - ',
		core_responsibilities.core_responsibility
	)</CommandText>
