                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT     member.Member_Add, member.Member_City, member.Member_Prov, member.member_country, member.Member_Postal, member.Member_Email, 
                      member_offers. DATE, member_offers.id, get_name(member_offers.id) AS membername, business_unit_name(member_offers.business_unit_id) branchname, 
                      get_name(member_offers.enteredby) AS enteredby, member_offers.wage, member_offers.startdate, member_offers.enddate, member_offers.vacation_interval_1, 
                      member_offers.vacation_interval_2, member_offers.vacation_interval_3, member_offers.vacation_amount_1, member_offers.vacation_amount_2, 
                      member_offers.vacation_amount_3, membertype.membertype_name, member_offers.membertypeid, member_offers.gets_vehicle, member_offers.gets_phone, 
                      member_offers.gets_laptop, get_name(member_offers.reports_to) reports_to, member_offers.has_comp, member_offers.comp_details, member_offers.notes, 
                      member_offers.is_salary, member_offers.deptid 
FROM         member INNER JOIN
                      member_offers ON member_offers.id = member.Member_ID INNER JOIN
                      membertype ON member_offers.membertypeid = membertype.membertype_id
WHERE     member_offers.id = ?moid</CommandText>
