<dx:ASPxComboBox runat="server" ShowShadow="False" Spacing="0" HorizontalAlign="Left" Height="25px" SpriteCssFilePath="{0}/sprite.css" CssPostfix="NETheme01" CssFilePath="{0}/styles.css" Font-Names="&#39;Segoe UI&#39;,Helvetica,&#39;Droid Sans&#39;,Calibri,Geneva,sans-serif;">
