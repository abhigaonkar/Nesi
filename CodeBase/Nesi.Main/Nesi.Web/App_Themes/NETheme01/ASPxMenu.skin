<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v19.2, Version=19.2.5.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dx" Namespace="DevExpress.Web" Assembly="DevExpress.Web.v19.2, Version=19.2.5.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>

<dx:ASPxMenu runat="server" AutoSeparators="RootOnly" ItemSpacing="0px" SeparatorHeight="100%" ShowSubMenuShadow="False" SpriteCssFilePath="{0}/sprite.css" CssPostfix="NETheme01" CssFilePath="{0}/styles.css">
    <HorizontalPopOutImage>
        <SpriteProperties HottrackedCssClass="dxWeb_mHorizontalPopOutHover_NETheme01" />
    </HorizontalPopOutImage>
    <VerticalPopOutImage>
        <SpriteProperties HottrackedCssClass="dxWeb_mVerticalPopOutHover_NETheme01" />
    </VerticalPopOutImage>
    <VerticalPopOutRtlImage>
        <SpriteProperties HottrackedCssClass="dxWeb_mVerticalPopOutHoverRtl_NETheme01" />
    </VerticalPopOutRtlImage>
    <ScrollUpButtonImage>
        <SpriteProperties HottrackedCssClass="dxWeb_mScrollUpHover_NETheme01" />
    </ScrollUpButtonImage>
    <ScrollDownButtonImage>
        <SpriteProperties HottrackedCssClass="dxWeb_mScrollDownHover_NETheme01" />
    </ScrollDownButtonImage>
    <LoadingPanelImage Url="Web/Loading.gif" />
    <SubMenuStyle GutterWidth="0px" />
</dx:ASPxMenu>


