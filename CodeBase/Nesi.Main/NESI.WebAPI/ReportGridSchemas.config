  <JobCostReport name="JobCostReport"
                reportFor=""
                editable="false"
                isPrivate="false"
                searchEndPoint="true"
                distinctEndPoint="true"
                exportToExcelEndPoint="true"
                hasSummaryRow="true" >
    <columns>
      <add name="pm" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="PM" isKey="false" ordinal="1"/>
      <add name="wo" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="BV WO" isKey="false" ordinal="2"
         hyperlink="true"
         hyperlinkUrl="[B]/redir.aspx?url=%2fwo_prog_frame.aspx%3faction%3dshow%26woprog_id%3d{{woprog_id}}"
         hyperlinkUrlParam="woprog_id"/>
      <add name="status" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="WO Status" isKey="false" ordinal="3"/>
      <add name="customer_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Customer Name" isKey="false" ordinal="5"/>
      <add name="descript" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Description" isKey="false" ordinal="6"/>
      <add name="matl_used" summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Material Sell ($)" ordinal="8" toolTip="The total extended sell price of material used on this &amp; all associated WO's" />
      <add name="bench_sell"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Benchmark Sell ($)" ordinal="9" toolTip="The total labor &amp; material sell minus the total cost from open PO's" />
      <add name="to_be_billed"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="To Be Billed on WO ($)" ordinal="10" toolTip="Amount left to bill on work order" />
      <add name="prog_billed" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Progress Billed (%)" isKey="false" ordinal="11" toolTip="The total percentage that has been progress billed" />
      <add name="total_cost"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Total Cost ($)" ordinal="12" toolTip="The total labor and material cost from the work order plus the total cost of all required materials not yet committed &amp; "/>
      <add name="overall_margin" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Overall Margin (%)" isKey="false" ordinal="14"  toolTip="The total quoted amount minus labor &amp; material cost, divided by the quoted amount" />
      <add name="actual_labor_hours" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="WO Labor (hrs)" display="true" ordinal="16" toolTip="The actual number of hours used on the work order" />
      <add name="labor_cost_tot"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Labor Cost ($)" ordinal="17" toolTip="The total cost dollar value of this and all other associated work orders." />
      <add name="labor_cost_per"  type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Labor Cost Per ($)" ordinal="18"  toolTip="The &quot;Labor Cost ($)&quot; divided by &quot;Actual Labor (hrs)&quot;" />
      <add name="labor_used" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Quoted Labor Used (%)" isKey="false" ordinal="19"   toolTip="&quot;Actual Labor (hrs)&quot; divided by &quot;Quoted Labor (hrs)&quot;" />
      <add name="material_quote_price"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Quoted Material Cost ($)" ordinal="20" toolTip="The total cost of all material lines from the quote" />
      <add name="material_used" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Quoted Material Used (%)" isKey="false" ordinal="21"  toolTip="&quot;Quoted Material Cost ($)&quot; divided by &quot;Actual Material Cost ($)&quot;" />
      <add name="labor_hours_remaining"  summary="sum" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Quoted Labor Remaining (hrs)" display="true" ordinal="22"   toolTip="&quot;Quoted Labor (hrs)&quot; minus the &quot;Actual Labor (hrs)&quot;" />
      <add name="material_actual_price"  summary="sum"  type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="WO Material Cost ($)" ordinal="23"  toolTip="Total material cost from this work order" />
      <add name="service_addr" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Service Address" isKey="false" ordinal="24"/>
      <add name="cut_date" type="System.DateTime" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Cut Date" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="25" />
      <add name="invoiced_date" type="System.DateTime" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Invoiced Date" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="26" />
      <add name="projected_labor_cost"  summary="sum"  type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Projected Labor Cost" ordinal="27" toolTip="&quot;Projected Labor Cost&quot;" />
      <add name="projected_material_cost"  summary="sum"   type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Projected Material Cost" ordinal="28" toolTip="&quot;Projected Material Cost&quot;" />
      <add name="projected_total_cost"  summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Projected Total Cost" ordinal="29"  toolTip="&quot;Projected Total Cost&quot;" />
      <add name="projected_margin" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Projected Margin" isKey="false" ordinal="30" />
      <add name="quoteid" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Quote #" isKey="false" ordinal="4"
           hyperlink="true" hyperlinkUrl="/#/opens/65/quotes/{{quoteid}}" hyperlinkUrlParam="quoteid"
      />
      <add name="quoted_amount_used" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Quoted Amount Used (%)" isKey="false" ordinal="13" toolTip="The quoted amount minus total material and labor sell minus required materials not yet committed cost divided by the quoted amount" />
      <add name="quoted_amount"   summary="sum" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Quoted Amount ($)" ordinal="7" />
      <add name="quote_margin_p" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Quote Margin (%)" isKey="false" ordinal="31" />
      <add name="quote_margin_dollars" summary="sum"  type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Quote Margin" ordinal="32" />
      <add name="quoted_labor_hours"  summary="sum" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Quoted Labor (hrs)" display="true" ordinal="15"  toolTip="The number of hours quoted on the quote worksheet" />
      <add name="woprog_id" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="false" header="Quote #" isKey="false" ordinal="33"/>
    </columns>
  </JobCostReport>

  <MasterQuoteGrid name="MasterQuoteGrid"
              reportFor=""
              editable="true"
