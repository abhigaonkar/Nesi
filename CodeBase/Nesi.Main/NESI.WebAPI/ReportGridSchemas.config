      <add name="pm_app" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Waiting PM App" display="true" ordinal="9" summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}"  />
      <add name="bm_app" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Waiting BM App" display="true" ordinal="10"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="bm_parent_app" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Waiting Parent BM Approval" display="true" ordinal="11" />
      <add name="cust_po" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Waiting for Cust PO" display="true" ordinal="12"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="to_be_invoiced" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Waiting to be Invoiced" display="true" ordinal="13"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="total_time" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Total Processing Time" display="true" ordinal="14"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="total_nesi" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Total Nesi" display="true" ordinal="15"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="total_branch" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Total Branch" display="true" ordinal="16"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
      <add name="invoice_date" type="System.DateTime" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Invoiced Dat" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="17" />
      <add name="last_hour" type="System.DateTime" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Last Time Entry" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="18" />
      <add name="wo_cut" type="System.DateTime" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Date Created" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="19" />
      <add name="rev" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Invoiced Amt" display="true" ordinal="20"  summary="sum" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}"  />
      <add name="wo_status" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="WO Status" isKey="false" ordinal="21"/>
