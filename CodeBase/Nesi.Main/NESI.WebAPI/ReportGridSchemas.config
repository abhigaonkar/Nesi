      <add name="contact_name"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Contact Name" isKey="false" ordinal="23" />
      <add name="customer_emails"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Email" isKey="false" ordinal="24" />
      <add name="invoice_lag" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="true" header="Invoice Lag" isKey="true"  summary="avg" toolTip="Days taken to prepare the invoice from the last day worked on the work order"  ordinal="25" />
      <add name="id" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="false" header="ID" isKey="true" ordinal="26" />
      <add name="phone"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Phone" isKey="false" ordinal="27" />
      <add name="pm"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="PM" isKey="false" ordinal="28" />
