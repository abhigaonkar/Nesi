                  viewInvoiceUrl="/sections/reports/invoice_preview/index.aspx?id={{woprog_id}}" viewInvoiceUrlParams="woprog_id"
                  hasSummaryRow="true">
    <columns>
      <add name="woprog_id" type="System.long" rawType="number" isKey="true" display="false" defaultFilter="equals" header="ID" ordinal="64"/>
      <add name="customer" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="Customer" ordinal="1"/>
      <add name="description" type="System.String" rawType="string" display="true" editable="true" defaultFilter="contains" header="Description" ordinal="2"/>
      <add name="expected_enddate" type="System.Nullable`1[System.DateTime]" rawType="datetime" displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" defaultFilter="equals" editable="true" display="true" header="Expected End Date" ordinal="3"/>
      <add name="expected_sales" type="System.Decimal" defaultFilter="equals" display="true" editable="true" header="Expected Sales" currency="true" rawType="currency" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" ordinal="4"/>
      <add name="rd" type="System.Nullable`1[System.Boolean]" rawType="boolean" display="true" editable="false" header="RD" ordinal="5"/>
      <add name="hold" type="System.Nullable`1[System.Boolean]" rawType="boolean" display="true" editable="false" header="On Hold" ordinal="6"/>
      <add name="warranty" type="System.Nullable`1[System.Int32]" rawType="number" defaultFilter="equals" display="true" header="Warranty" ordinal="7"/>
      <add name="po" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="PO" ordinal="8"/>
      <add name="bvwo" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="BVWO" ordinal="9" hyperlink="true"
           hyperlinkUrl="[B]#/home/0/%2Fwo_prog_frame.aspx%3Faction%3Dshow%26woprog_id%3D{{woprog_id}}"
           mobileHyperlinkUrl="[B]/redir.aspx?url=%2Fsections%2Fworkorder%2Fmobile_wo%2Findex.aspx%3Fid%3D{{woprog_id}}%26is_mobile%3D1"
           hyperlinkUrlParam="woprog_id,business_unit_id"/>
      <add name="notes" type="System.String" rawType="notes" defaultFilter="contains" display="true" editable="true" header="Notes" ordinal="10"/>
      <add name="sc" type="System.Nullable`1[System.Boolean]" rawType="boolean" display="true" editable="false" header="Service Call" ordinal="12"/>
      <add name="asset" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="Asset" ordinal="13"/>
      <add name="gross_profit" type="System.Nullable`1[System.Decimal]" currency="true" rawType="currency" defaultFilter="equals" display="true" editable="false" summary="sum" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" header="Gross Profit" ordinal="14"/>
      <add name="city" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="City" ordinal="15"/>
      <add name="province" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="State" ordinal="16"/>
      <add name="customer_req_po" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="Customer Requires PO" ordinal="17" />
      <add name="country" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="Country" ordinal="18"/>
      <add name="ram" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="RAM" ordinal="19"/>
      <add name="materialcost" type="System.Nullable`1[System.Decimal]" currency="true" rawType="currency" defaultFilter="equals" display="true" editable="false" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" header="Mat Cost" summary="sum" ordinal="20"/>
      <add name="laborcost" type="System.Nullable`1[System.Decimal]" currency="true" rawType="currency" defaultFilter="equals" display="true" editable="false" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" header="Lab Cost" summary="sum" ordinal="21"/>


      <add name="quote" type="System.String" rawType="string" display="true" defaultFilter="contains" header="Quote" ordinal="22" hyperlink="true" hyperlinkUrl="/#/opens/65/quotes/{{quote}}" hyperlinkUrlParam="quote" />
      <add name="jobcost" type="System.Decimal" currency="true" rawType="currency"  displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" defaultFilter="equals" display="true" backcolor="#FFC0C0" summary="sum" header="Benchmark Sell" ordinal="23" groupSummary="sum" groupSummaryOrdinal="2" />
      <add name="remainder" type="System.Decimal" rawType="currency" defaultFilter="equals" display="true" header="Left on Quote" ordinal="24" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" groupSummary="sum" groupSummaryOrdinal="3" />
      <add name="status" type="System.String" rawType="string" defaultFilter="contains" display="true" header="Status" ordinal="25"/>
