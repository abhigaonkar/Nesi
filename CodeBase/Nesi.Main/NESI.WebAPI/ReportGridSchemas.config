      <add name="note_date" type="System.String" rawType="datetime" defaultFilter="equals" editable="false" display="true" header="Note Date" isKey="false"  displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" ordinal="18" />
      <add name="terms"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="WO Terms" isKey="false" ordinal="19" />
