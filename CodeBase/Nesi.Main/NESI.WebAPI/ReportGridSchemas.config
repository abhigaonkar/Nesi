      <add name="woprog_invoice_collection_status"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Invoice Status" isKey="false" ordinal="9" />
      <add name="wOProg_BVWO"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Work Order" isKey="false" ordinal="10"
           hyperlink="true"
           hyperlinkUrl="[B]#/home/0/%2Fwo_prog_frame.aspx%3Faction%3Dshow%26woprog_id%3D{{woprog_id}}"
           mobileHyperlinkUrl="[B]/redir.aspx?url=%2Fsections%2Fworkorder%2Fmobile_wo%2Findex.aspx%3Fid%3D{{woprog_id}}%26is_mobile%3D1"
           hyperlinkUrlParam="woprog_id" />
      <add name="wOProg_CustPO"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Cust PO" isKey="false" ordinal="11" />
