      <add name="qty_ordered" type="System.Double" rawType="number" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="QTY Ordered" backcolor="#CCFFCC" ordinal="12" />
