                              distinctEndPoint="true"
                              exportToExcelEndPoint="true"
                              exportToPdfEndPoint="true"
                               >
    <columns>
      <add name="id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="id" isKey="true" ordinal="1" />
      <add name="addedbymemberid" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="addedbymemberid" isKey="false" ordinal="2" />
      <add name="membertypeid" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="membertypeid" isKey="false" ordinal="3" />
      <add name="business_unit_id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="business_unit_id" isKey="false" ordinal="4" />
      <add name="name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Name" isKey="false" ordinal="5" />
      <add name="status" type="System.String" rawType="dropdown" defaultFilter="contains" editable="false" display="true" header="Status" isKey="false" ordinal="6" />
      <add name="addedbyname" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Entered By" isKey="false" ordinal="7" />
      <add name="dateentered" type="System.Datetime" rawType="datetime" defaultFilter="contains" editable="false" display="true" header="Start Date" isKey="false" ordinal="8" />
      <add name="membertype_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="MemberType" isKey="false" ordinal="9" />
      <add name="business_unit_name" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Business Unit" isKey="false" ordinal="10" />
      <add name="offer_status" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="HR Status" isKey="false" ordinal="11" />
      <add name="cellphone" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Cell Phone" isKey="false" ordinal="12" />
      <add name="email" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Email" isKey="false" ordinal="13" />
      <add name="notes" type="System.String" rawType="textbox" defaultFilter="contains" editable="false" display="true" header="Notes" isKey="false" ordinal="14" />
    </columns>
