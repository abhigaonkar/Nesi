  <MasterWorkOrder name="MasterWorkOrder"
                   reportFor=""
                   editable="true"
                  isPrivate="false"
                  editEndPoint="show"
                  bulkEditEndPoint="api/Page/MasterWorkOrder/BulkEditAsset"
                  searchEndPoint="api/Page/MasterWorkOrder/Search"
                  distinctEndPoint="api/Page/MasterWorkOrder/GetDistinct"
