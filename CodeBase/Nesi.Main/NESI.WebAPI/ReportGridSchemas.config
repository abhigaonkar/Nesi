      <add name="dayssince" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="true" header="Days Since" isKey="true" ordinal="13" />
      <add name="cust_no" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="true" header="Customer No" isKey="true" ordinal="14" />
      <add name="balance" type="System.Double" rawType="currency" defaultFilter="equals" editable="false" currency="true" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" display="true" header="Balance"  summary="sum"  ordinal="15" />
