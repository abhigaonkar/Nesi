      <add name="grossmargin" type="System.Nullable`1[System.Decimal]" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" display="true" summary="avg" header="Gross Margin" ordinal="27"/>
      <add name="completion" type="System.Decimal" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" display="true" header="Completion" ordinal="28"/>
      <add name="pm" type="System.String" rawType="string" defaultFilter="contains" display="true" header="PM" ordinal="29"/>
      <add name="invoiced_amount" type="System.Nullable`1[System.Decimal]" display="true" backcolor="#E0E0E0" currency="true" rawType="currency" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" defaultFilter="equals" summary="sum" header="Invoiced Amount"  groupSummary="sum" groupSummaryOrdinal="4" ordinal="30"/>
      <add name="quotedamount" type="System.Nullable`1[System.Decimal]" currency="true" rawType="currency"  displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" defaultFilter="equals" display="true" backcolor="#C0FFC0" summary="sum"  groupSummary="sum" groupSummaryOrdinal="1" header="Quoted Amount" ordinal="31"/>
      <add name="invoice_date" type="System.Nullable`1[System.DateTime]" rawType="datetime" displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" defaultFilter="equals" display="true" header="Invoice Date" ordinal="32"/>
