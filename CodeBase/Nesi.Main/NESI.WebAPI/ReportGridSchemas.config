  <Location name="Location" editable="false">
    <columns>
      <add name="address_id" type="System.Int32" editable="false" display="true" header="address_id" isKey="true" ordinal="1" />
      <add name="address_table" type="System.String" display="true" header="address_table" ordinal="6" />
      <add name="address_table_id" type="System.Int32" header="address_table_id" display="true" ordinal="8" />
      <add name="Address_Type" type="System.String" header="Address_Type" />
      <add name="Address_Desc" type="System.String" header="Address_Desc" ordinal="4" />
      <add name="Address_Addr1" type="System.String" header="Address_Addr1" ordinal="7" />
    </columns>
  </Location>

  <!--		
124.	number => percent,		
125.	string => hyperlink, hyperlinkUrl,		
126.	boolean,		
127.	datetime,		
128.	currency,		
129.	email,		
130.	notes,		
131.	phone,		
132.	  -->
  <CustomerAsset name="CustomerAsset"
                 reportFor=""
                 editable="true" isPrivate="false"
                 createEndPoint="api/Page/CustomerAsset/CreateAsset"
                 editEndPoint="api/Page/CustomerAsset/EditAsset"
                 deleteEndPoint="api/Page/CustomerAsset/DeleteAsset"
                 bulkEditEndPoint="api/Page/CustomerAsset/BulkEditAsset"
                 searchEndPoint="api/Page/CustomerAsset/Search"
                 distinctEndPoint="api/Page/CustomerAsset/GetDistinct"
                 exportToExcelEndPoint="api/Page/CustomerAsset/ExportToExcel"
                 exportToPdfEndPoint="api/Page/CustomerAsset/ExportToPDF"
                 >
    <columns>
      <add name="id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="true" header="ID" isKey="true" ordinal="1" />
      <add name="name" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="true" validation="{&quot;required&quot;:true,&quot;maxLength&quot;:60}" header="Asset Name" ordinal="4" />
      <add name="description" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="true" header="Description" ordinal="5" />
      <add name="active" type="System.Boolean" rawType="boolean" header="Active" editable="true" display="true" ordinal="8" />
      <add name="addedby" type="System.String" rawType="string" defaultFilter="contains" display="true" editable="false" header="Added By Who?" ordinal="9" />
      <add name="manufacturer" type="System.String" rawType="string" defaultFilter="contains" header="Manufacturer" editable="true" validation="{&quot;maxLength&quot;:255}" display="true" ordinal="6" />
      <add name="model" type="System.String" rawType="string" defaultFilter="contains" header="Model" display="true" editable="true" validation="{&quot;maxLength&quot;:255}" ordinal="7" />
      <add name="customer_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Customer" ordinal="2"/>
      <!--<add name="member_FullName" type="System.String" rawType="string" editable="false" display="true" header="Added By Who?" ordinal="9" />-->
      <add name="address_id" type="System.Nullable`1[System.Int32]" rawType="number" display="false" editable="true" header="Location" lookup="api/Page/Location/Search?filtercolumn=address_table||customer;address_id;location@location;address_table_id@customer_id" ordinal="3" />
      <add name="customer_id" type="System.Nullable`1[System.Int32]" rawType="number" display="false" editable="true" validation="{&quot;required&quot;:true}" lookup="api/Page/Customer/Search;customerID;customerName@customer_name" header="Customer" ordinal="2" />
      <!--<add name="member_Id" type="System.Nullable`1[System.Int32]" rawType="number" display="false" editable="false" header="Member ID" />-->
      <add name="location" type="System.String" rawType="string" display="true" header="Location" editable="false" ordinal="3" />
    </columns>
  </CustomerAsset>

  <EmployeeDaysOffGrid name="EmployeeDaysOffGrid"
                     reportFor=""
                     editable="true"
                     isPrivate="false"
                     createEndPoint="true"
                     editEndPoint="true"
                     deleteEndPoint="true"
                     searchEndPoint="true"
                     distinctEndPoint="true"
                       exportToExcelEndPoint="true"
                       exportToPdfEndPoint="true"
  >
    <columns>
      <add name="id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="true" header="ID" isKey="true" ordinal="1" />
      <add name="employee" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Requested By" isKey="false" ordinal="2" />
      <add name="date_requested" type="System.Datetime" rawType="Datetime" defaultFilter="contains"  editable="false" display="true" header="Date Requested" isKey="false" ordinal="3" />
      <add name="date_start" type="System.Datetime" rawType="Datetime" defaultFilter="contains" validation="{&quot;required&quot;:true}" editable="true" display="true" header="Start Date" isKey="false" ordinal="4" />
      <add name="date_end" type="System.Datetime" rawType="Datetime" defaultFilter="contains" validation="{&quot;required&quot;:true}" editable="true" display="true" header="End Date" isKey="false" ordinal="5" />
      <add name="requesttype_id" type="System.int"
           lookup="api/Page/EmployeeDaysOffGrid/RequestTypeList;value;label@requesttype;label@requesttype_id"
           rawType="number" defaultFilter="equal" validation="{&quot;required&quot;:true}" editable="true" display="false" header="Request Type" isKey="false" ordinal="6" />
      <add name="requesttype" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Request Type" isKey="false" ordinal="7" />
      <add name="type_id" type="System.int"
           lookup="api/Page/EmployeeDaysOffGrid/DayoffTypeList;type_id;type_id@leavetype;label@value"
           rawType="number" defaultFilter="equal" editable="true" validation="{&quot;required&quot;:true}" display="false" header="Leave Type" isKey="false" ordinal="8" />
      <add name="leavetype" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Leave Type" isKey="false" ordinal="9" />
      <add name="comments" type="System.String" rawType="notes" defaultFilter="contains" editable="true" display="true" header="Comments" isKey="false" ordinal="10" />
    </columns>
  </EmployeeDaysOffGrid>

	<CustomerBusinessUnitGrid name="CustomerBusinessUnitGrid"
	reportFor=""
	editable="false"
	isPrivate="false"
	searchEndPoint="true"
	distinctEndPoint="true">
	<columns>
		<add name="business_unit_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Business Unit" isKey="false" ordinal="3" />
		<add name="bdm" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Business Development Manager" isKey="false" ordinal="7" />
	</columns>
	</CustomerBusinessUnitGrid>
	


  <WorkOrderBusinessUnitDetail name="WorkOrderBusinessUnitDetail"
                               reportFor=""
                               editable="false"
                               isPrivate="false"
                               searchEndPoint="true"
                               distinctEndPoint="true"
                               exportToExcelEndPoint="true"
                               exportToPdfEndPoint="true"
                               >
    <columns>
      <add name="woprog_id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="woprog_id" isKey="true" ordinal="1" />
      <add name="business_unit_id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="business_unit_id" isKey="false" ordinal="1" />
      <add name="customer_id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="customer_id" isKey="false" ordinal="1" />
      <add name="woprog_bvwo" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Wo No" isKey="true" ordinal="2"
           hyperlink="true" hyperlinkUrl="[B]/#/home/0/%2fwo_prog_frame.aspx%3faction%3dshow%26woprog_id%3d{{woprog_id}}%26business_unit_id%3d{{business_unit_id}}"
           mobileHyperlinkUrl="[B]/redir.aspx?url=%2Fmobile%2Findex.aspx?a=workorder%26woprog_id={{woprog_id}}%26is_mobile%3D1"
           hyperlinkUrlParam="woprog_id,business_unit_id"/>
      <add name="woprog_customername" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Customer Name" isKey="false" ordinal="3"
           hyperlink="true" hyperlinkUrl="[B]/#/home/10/customers/edit/{{customer_id}}" hyperlinkUrlParam="customer_id"/>
      <add name="woprog_description" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Description" isKey="false" ordinal="4" />
      <add name="woprog_custpo" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Cust PO" isKey="false" ordinal="4" />
      <add name="status" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Status" isKey="false" ordinal="5" />
      <add name="last_modified" type="System.DateTime" rawType="datetime" displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" defaultFilter="equals" editable="false" display="true" header="Last Modified" isKey="false" ordinal="6" />
      <add name="cutby" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Last Modified By" isKey="false" ordinal="7" />
      <add name="woprog_stilltobebilled" type="System.Double" rawType="currency" displayFormat="{&quot;currency&quot;: &quot;CAD&quot;, &quot;format&quot;: &quot;1.2-2&quot;}" currency="true" defaultFilter="equals" editable="false" display="true" header="Still to be Billed" isKey="false" ordinal="8" />
      <add name="woprog_cutdatetime" type="System.DateTime" rawType="datetime" displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" defaultFilter="equals" editable="false" display="true" header="Cut Date" isKey="false" ordinal="9" />
      <add name="quote_id" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="Quote" isKey="false" ordinal="10"  hyperlink="true" hyperlinkUrl="/#/opens/65/quotes/{{quote_id}}" hyperlinkUrlParam="quote_id" />
      <add name="pm" type="System.String" rawType="string" defaultFilter="equals" editable="false" display="true" header="PM" isKey="false" ordinal="11" />
      <add name="woprog_invoiceno" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Invoice #" isKey="false" ordinal="12" />
      <add name="contact_Name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Contact" isKey="false" ordinal="13" />
      <add name="open_dt" type="System.String" rawType="datetime" displayFormat="{&quot;format&quot;: &quot;yyyy-MM-dd&quot;}" defaultFilter="contains" editable="false" display="true" header="Next Date" isKey="false" ordinal="14" />
      <add name="hold" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="On Hold" isKey="false" ordinal="15" />
      <add name="margin" type="System.String" rawType="percent" displayFormat="{&quot;format&quot;:&quot;1.2-2&quot;}" defaultFilter="equals" editable="false" display="true" header="Margin" isKey="false" ordinal="16" />
      <add name="workorder_schedule_date" type="System.String" rawType="string"  defaultFilter="equals" editable="false" display="false" header="Schedule Date" isKey="false" ordinal="17" />
    </columns>
  </WorkOrderBusinessUnitDetail>
	<CustomerRequestAdminGrid name="CustomerRequestAdminGrid"
								  reportFor=""
								  editable="true"
								  isPrivate="false"
								  searchEndPoint="true"
								  editEndPoint="show"
								  deleteEndPoint="true"
								  createEndPoint="show"
								  distinctEndPoint="true">
		<columns>
			<add name="id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="id" isKey="true" ordinal="1" />
			<add name="name" type="System.String" rawType="string" defaultFilter="contains" editable="true" display="true" header="Name" isKey="false" ordinal="2" />
			<add name="is_active" type="System.Boolean" rawType="boolean" defaultFilter="equals" editable="true" display="true" header="Active" isKey="false" ordinal="3" />
		</columns>
	</CustomerRequestAdminGrid>

  <ApplicantHomeGrid name="ApplicantHomeGrid"
