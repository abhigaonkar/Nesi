      <add name="scan_time" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="true" header="Scan Time" isKey="true"  summary="avg" ordinal="30" />
      <add name="woprog_id" type="System.long" rawType="number" defaultFilter="equals" editable="false" display="true" header="ID" isKey="true" ordinal="31" />
      <add name="invoice_collection_status_name"  type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Invoice Status String" isKey="false" ordinal="32" />
  
    </columns>
