  <InvoicingTime name="InvoicingTime"
              reportFor=""
              editable="false"
              isPrivate="false"
              searchEndPoint="true"
              distinctEndPoint="true"
              exportToExcelEndPoint="true"
              hasSummaryRow="true" >
    <columns>
      <add name="bvwo" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="WO" isKey="false" ordinal="1"
           hyperlink="true"
           hyperlinkUrl="/sections/workorder/index.aspx?action=show&amp;woprog_id={{id}}&amp;business_unit_id=0"
           hyperlinkUrlParam="id"
           />
      <add name="business_unit" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Business Unit" isKey="false" ordinal="2"/>
      <add name="pm" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="PM" isKey="false" ordinal="3"/>
      <add name="customer" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Customer" isKey="false" ordinal="4"/>
      <add name="to_scan" type="System.Double"  rawType="number" defaultFilter="equals" editable="false" currency="false" header="Time to Scan" display="true" ordinal="5"  summary="avg" displayFormat="{&quot;format&quot;: &quot;1.1-1&quot;}" />
