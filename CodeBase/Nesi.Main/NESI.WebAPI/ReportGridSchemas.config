  <EmployeesHomeGrid name="EmployeesHomeGrid"
                              reportFor=""
                              editable="true"
                              isPrivate="false"
                              searchEndPoint="true"
                              editEndPoint="show"
                              deleteEndPoint=""
                              createEndPoint=""
                              distinctEndPoint="true"
                              exportToExcelEndPoint="true"
                              exportToPdfEndPoint="true"
                               >
    <columns>
      <add name="mo_id" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="false" header="mo_id" isKey="false" ordinal="1" />
      <add name="_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Member Name" isKey="false" ordinal="2" />
      <add name="contact" type="System.Int32" rawType="string" defaultFilter="equals" editable="false" display="true" header="Contact" isKey="false" ordinal="3"
           hyperlink="true" hyperlinkUrl="[C]{{memberid}}"
           hyperlinkUrlParam="memberid"/>
      <add name="loginstatus" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Login Status" isKey="false" ordinal="4" />
      <add name="memberid" type="System.Int32" rawType="number" defaultFilter="equals" editable="false" display="true" header="Emp ID" isKey="true" ordinal="5" />
      <add name="ext" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Ext" isKey="false" ordinal="6" />
      <add name="cell" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Cell Phone" isKey="false" ordinal="7" />
      <add name="bu_name" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Business Unit" isKey="false" ordinal="8" />
      <add name="user" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Login Name" isKey="false" ordinal="9" />
      <add name="hrstatus_text" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="HR Status" isKey="false" ordinal="10" />
      <add name="title" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Title" isKey="false" ordinal="11" />
      <add name="neemail" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Company Email" isKey="false" ordinal="12" />
      <add name="v" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="On Vacation" isKey="false" ordinal="12"/>
      <add name="day_off" type="System.String" rawType="fa" defaultFilter="contains" editable="false" display="true" header="Day off" isKey="false" ordinal="12"
           hyperlink="true" hyperlinkUrl="/sections/hr/member/days_off.aspx?id={{memberid}}&amp;single=true"
           hyperlinkUrlParam="memberid"
           />
      <add name="mo_status" type="System.String" rawType="string" defaultFilter="contains" editable="false" display="true" header="Agreement Status" isKey="false" ordinal="14"
    hyperlink="true" hyperlinkUrl="/sections/hr/member/offer_print_off.aspx?moid={{mo_id}}"
