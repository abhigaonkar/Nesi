      <Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
        <EntityContainerMapping StorageEntityContainer="NESIStoreContainer" CdmEntityContainer="NESIMySQL">
          <EntitySetMapping Name="accounting_period">
            <EntityTypeMapping TypeName="NESI.accounting_period">
              <MappingFragment StoreEntitySet="accounting_period">
